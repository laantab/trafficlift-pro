# TrafficLift Pro v2.0 — Environment Variables
# Copy this file to .env and fill in your values.

# ── OpenAI (AI Content Generation) ───────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Model to use: gpt-4o (default), gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o

# ── MiniMax (Video Generation Parameters) ────────────────────────────────────
# Get your key and Group ID at https://www.minimaxi.com/document/Guides
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_GROUP_ID=your-group-id-here

# ── Server Configuration ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=info

# ── AI Mode Priority ─────────────────────────────────────────────────────────
# If OPENAI_API_KEY is set, OpenAI is used automatically.
# MiniMax supplements with video generation parameters (avatar/t2v).
# Without any keys: Template Fallback Mode — fully functional, no cost.

# TrafficLift Pro — environment template.
# Copy to .env and fill in any keys you have. Anything left blank falls back
# to a template-based generator (zero-key path), so the app boots without
# any of these set.

# ── Primary live-research provider (optional but recommended) ───────────────
# When set, /api/v1/find-winner uses Tavily for fresh web evidence.
# When blank, the app falls back to a DuckDuckGo HTML search.
TAVILY_API_KEY=

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Enables GPT-4o augmentation: fresh AI-generated winner when live research
# is unavailable, and AI-generated pin / video / tweet copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── MiniMax video rendering (optional) ───────────────────────────────────────
# Enables /api/v1/video/generate — real MP4 output via H3-Max / Hailuo.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ── Logging / runtime ────────────────────────────────────────────────────────
LOG_LEVEL=info
HOST=0.0.0.0
RELOAD=false

# ── Persistent SQLite store (Render: /var/data/) ────────────────────────────
CAMPAIGNS_DB_PATH=/var/data/campaigns.db
# ── HeyGen Video V2 (owner-only, disabled by default) ───────────────────────
# A ChatGPT HeyGen connector is not an API key for TrafficLift.
# Use a *server-side* HeyGen developer API key. Never put it in index.html.
HEYGEN_API_KEY=
TRAFFICLIFT_HEYGEN_VIDEO_ENABLED=0
# Owner authorization still uses TRAFFICLIFT_HOSTED_VIDEO_ACCESS_TOKEN.
# Paid generation additionally requires approve_paid_generation=true in the POST.

# ── Krea Seedance image-to-video (owner-only, disabled by default) ─────────
# App subscription credits do NOT fund Krea API requests.
# Set KREA_API_KEY privately in Render; never commit credentials.
KREA_API_KEY=
TRAFFICLIFT_KREA_VIDEO_ENABLED=0

# YouTube Launch Studio (owner-only, opt in after OAuth/API eligibility review).
TRAFFICLIFT_YOUTUBE_ENABLED=0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match the Google web OAuth client's registered callback exactly.
YOUTUBE_REDIRECT_URI=https://your-trafficlift-host/api/v1/publishing/youtube/callback
# Generate once using cryptography.fernet.Fernet.generate_key(). Persist as a secret.
# Losing this key makes saved OAuth grants and publishing jobs unreadable.
TRAFFICLIFT_PUBLISHING_KEY=
# Owner authorization: existing TRAFFICLIFT_HOSTED_VIDEO_ACCESS_TOKEN.
# Every paid POST must also provide approve_paid_generation=true and
# confirm_video_photo=true. Krea Video Studio images stay separate from Pinterest.
# Campaign pipeline is opt-in. Configure secrets on the server, never in HTML.
# Three posts TOTAL per week, not three posts per platform. Policy defaults OFF.
TRAFFICLIFT_PIPELINE_ENABLED=0
# YouTube reuses Launch Studio's encrypted OAuth connection and publishing key.
# Pinterest needs Standard API access; the Codex connector is a separate grant.
PINTEREST_ACCESS_TOKEN=
PINTEREST_USERNAME=
PINTEREST_BOARD_ID=
# TikTok requires audited Direct Post access, video.publish and video.list scopes.
# Expired tokens stop posting; do not paste credentials into the dashboard/chat.
TIKTOK_ACCESS_TOKEN=
TIKTOK_USERNAME=

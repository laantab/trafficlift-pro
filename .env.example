# TrafficLift Pro — environment template.
# Copy to .env and fill in any keys you have. Anything left blank falls back
# to a template-based generator (zero-key path), so the app boots without
# any of these set.

# ── Primary live-research provider (optional but recommended) ───────────────
# When set, /api/v1/find-winner uses Tavily for fresh web evidence.
# When blank, the app falls back to a DuckDuckGo HTML search.
TAVILY_API_KEY=

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# Enables GPT-4o augmentation: fresh AI-generated winner when live research
# is unavailable, and AI-generated pin / video / tweet copy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── MiniMax video rendering (optional) ───────────────────────────────────────
# Enables /api/v1/video/generate — real MP4 output via H3-Max / Hailuo.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# ── Logging / runtime ────────────────────────────────────────────────────────
LOG_LEVEL=info
HOST=0.0.0.0
RELOAD=false

# ── Persistent SQLite store (Render: /var/data/) ────────────────────────────
CAMPAIGNS_DB_PATH=/var/data/campaigns.db
# ── HeyGen Video V2 (owner-only, disabled by default) ───────────────────────
# A ChatGPT HeyGen connector is not an API key for TrafficLift.
# Use a *server-side* HeyGen developer API key. Never put it in index.html.
HEYGEN_API_KEY=
TRAFFICLIFT_HEYGEN_VIDEO_ENABLED=0
# Owner authorization still uses TRAFFICLIFT_HOSTED_VIDEO_ACCESS_TOKEN.
# Paid generation additionally requires approve_paid_generation=true in the POST.

exit /b
# POWERSHELL_START
$ErrorActionPreference = 'Stop'
$newRoot = $null
$created = $false
try {
    $shell = New-Object -ComObject WScript.Shell
    $shortcutFile = Join-Path ([Environment]::GetFolderPath('Desktop')) 'TrafficLift Studio.lnk'
    $runtime = $null
    if (Test-Path $shortcutFile) {
        $existing = $shell.CreateShortcut($shortcutFile)
        $candidateRuntime = $existing.WorkingDirectory
        $reference = Join-Path $candidateRuntime '.runtime-root'
        if (Test-Path $reference) { $candidateRuntime = [IO.File]::ReadAllText($reference).Trim() }
        if (Test-Path (Join-Path $candidateRuntime '.video-venv\Scripts\python.exe')) { $runtime = $candidateRuntime }
    }
    if (!$runtime) {
        Add-Type -AssemblyName System.Windows.Forms
        $picker = New-Object Windows.Forms.OpenFileDialog
        $picker.Title = 'Select Start_Free_Video_Studio.bat from your existing TrafficLift installation'
        $picker.Filter = 'TrafficLift launcher|Start_Free_Video_Studio.bat'
        if ($picker.ShowDialog() -ne 'OK') { throw 'No installation selected. Nothing changed.' }
        $runtime = Split-Path $picker.FileName -Parent
    }
    $python = Join-Path $runtime '.video-venv\Scripts\python.exe'
    $model = Join-Path $runtime 'models\kokoro-v1.0.int8.onnx'
    $voices = Join-Path $runtime 'models\voices-v1.0.bin'
    foreach ($file in @($python,$model,$voices)) {
        if (!(Test-Path -LiteralPath $file)) { throw ('Your existing local video setup is missing ' + (Split-Path $file -Leaf) + '. The current app was not changed.') }
    }
    $listeners = @(Get-NetTCPConnection -LocalPort 8005 -State Listen -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique)
    foreach ($listener in $listeners) {
        $running = Get-CimInstance Win32_Process -Filter ('ProcessId=' + $listener)
        $health = Invoke-RestMethod 'http://127.0.0.1:8005/api/v1/health' -TimeoutSec 5
        if ($running.CommandLine -notmatch 'trafficlift_pro:app' -or $running.CommandLine -notmatch '--port 8005' -or $health.version -notmatch '^5\.') { throw 'Port 8005 is used by another program. Close that program before installing.' }
        Write-Host 'Stopping the previous Pro 5 server to install the upgrade. Saved campaigns are preserved.'
        & taskkill.exe /PID $listener /T /F | Out-Null
        if ($LASTEXITCODE -ne 0) { throw 'Could not close the previous Pro 5 server.' }
    }

    $newRoot = Join-Path $env:LOCALAPPDATA ('TrafficLift-Studio\releases\campaign-studio-5.2.2-' + (Get-Date -Format 'yyyyMMdd-HHmmss'))
